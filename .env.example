# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
XAI_API_KEY=xai-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# TradingAgents
TRADINGAGENTS_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.2
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5-mini
TRADINGAGENTS_BACKEND_URL=

# Daily Limits
FREE_DAILY_LIMIT=4

# Models
DEFAULT_TECHNICAL_MODEL=gpt-5.2
DEFAULT_NEWS_MODEL=gpt-5-mini
DEFAULT_SOCIAL_MODEL=gpt-5-mini
DEFAULT_FUNDAMENTALS_MODEL=gpt-5-mini